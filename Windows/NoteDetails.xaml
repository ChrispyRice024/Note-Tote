<Window x:Class="Note_Tote.Windows.NoteDetails"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Note_Tote.Windows"
        mc:Ignorable="d"
        Title="NoteDetails" Height="550" Width="400">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height=".45*"/>
                <RowDefinition/>
                <RowDefinition Height=".45*"/>
            </Grid.RowDefinitions>
            <StackPanel x:Name="TitlePanel">
                <Grid HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button
                        Grid.Row="0"
                        x:Name="UpdateBtn"
                        Content="🖍️"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right"
                        Panel.ZIndex="10"
                        FontSize="12"
                        BorderThickness="0"
                        Background="Transparent"
                        Click="UpdateBtn_Click"
                        />
                    <Button
                        Grid.Row="0"
                        x:Name="DeleteBtn"
                        Content="🗑️"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right"
                        Margin="0,0,20,0"
                        Panel.ZIndex="10"
                        FontSize="12"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="DeleteBtn_Click"
                        />
                </Grid>
                <Border BorderBrush="Black" BorderThickness="0,0,0,2" Width="Auto">
                    <TextBlock x:Name="NoteNameTxt" FontSize="32" FontWeight="Bold" Width="Auto" Margin="0,0,0,0" Text="Title" HorizontalAlignment="Center"/>
                </Border>

            </StackPanel>
            <!--Description Grid.Row="1"-->
            <Border Grid.Row="1" Margin="10" BorderThickness="2" BorderBrush="Black" CornerRadius="8">
                <TextBlock x:Name="NoteDescTxt"
                       Grid.Row="1"
                       TextWrapping="Wrap"
                       Padding="10,5"
                       />
            </Border>

            <!--Dates Grid.Row="2"-->
            <StackPanel x:Name="DatesPanel" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                <Border BorderThickness="2" BorderBrush="Black" CornerRadius="8" Width="100" Margin="20">
                    <Grid>
                        <Label x:Name="StartDateLbl" Content="Start Date" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="StartDateTxt" Text="StartDate" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border BorderThickness="2" BorderBrush="Black" CornerRadius="8" Width="100" Margin="20">
                    <Grid>
                        <Label x:Name="DueDateLbl" Content="Due Date" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DueDateTxt" Text="DueDate" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
